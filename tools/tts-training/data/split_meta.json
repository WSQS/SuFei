      {
        "poem_id": "poem_0000",
        "mel_len": 595,
        "len_bin": "short",
        "text": "江南曲，唐代·李益。嫁得瞿塘贾，朝朝误妾期。早知潮有信，嫁与弄潮儿。"
      },
      {
        "poem_id": "poem_0309",
        "mel_len": 696,
        "len_bin": "short",
        "text": "瑶池，唐代·李商隐。瑶池阿母绮窗开，黄竹歌声动地哀。八骏日行三万里，穆王何事不重"
      },
      {
        "poem_id": "poem_0095",
        "mel_len": 705,
        "len_bin": "short",
        "text": "秋夜曲，唐代·王维。桂魄初生秋露微，轻罗已薄未更衣。银筝夜久殷勤弄，心怯空房不忍"
      },
      {
        "poem_id": "poem_0194",
        "mel_len": 710,
        "len_bin": "short",
        "text": "和张仆射塞下曲·其三，唐代·卢纶。月黑雁飞高，单于夜遁逃。欲将轻骑逐，大雪满弓刀"
      },
      {
        "poem_id": "poem_0236",
        "mel_len": 736,
        "len_bin": "short",
        "text": "闺怨，唐代·王昌龄。闺中少妇不知愁，春日凝妆上翠楼。忽见陌头杨柳色，悔教夫婿觅封"
      },
      {
        "poem_id": "poem_0025",
        "mel_len": 759,
        "len_bin": "short",
        "text": "逢入京使，唐代·岑参。故园东望路漫漫，双袖龙钟泪不干。马上相逢无纸笔，凭君传语报"
      },
      {
        "poem_id": "poem_0296",
        "mel_len": 774,
        "len_bin": "short",
        "text": "宫词 / 宫中词，唐代·朱庆馀。寂寂花时闭院门，美人相并立琼轩。含情欲说宫中事，"
      },
      {
        "poem_id": "poem_0274",
        "mel_len": 778,
        "len_bin": "mid",
        "text": "送别，唐代·王维。下马饮君酒，问君何所之？君言不得意，归卧南山陲。但去莫复问，白"
      },
      {
        "poem_id": "poem_0268",
        "mel_len": 788,
        "len_bin": "mid",
        "text": "九月九日忆山东兄弟，唐代·王维。独在异乡为异客，每逢佳节倍思亲。遥知兄弟登高处，"
      },
      {
        "poem_id": "poem_0169",
        "mel_len": 1004,
        "len_bin": "mid",
        "text": "春望，唐代·杜甫。国破山河在，城春草木深。感时花溅泪，恨别鸟惊心。烽火连三月，家"
      },
      {
        "poem_id": "poem_0204",
        "mel_len": 1021,
        "len_bin": "mid",
        "text": "归嵩山作，唐代·王维。清川带长薄，车马去闲闲。流水如有意，暮禽相与还。荒城临古渡"
      },
      {
        "poem_id": "poem_0214",
        "mel_len": 1034,
        "len_bin": "mid",
        "text": "月夜忆舍弟，唐代·杜甫。戍鼓断人行，边秋一雁声。露从今夜白，月是故乡明。有弟皆分"
      },
      {
        "poem_id": "poem_0112",
        "mel_len": 1042,
        "len_bin": "mid",
        "text": "书边事，唐代·张乔。调角断清秋，征人倚戍楼。春风对青冢，白日落梁州。大漠无兵阻，"
      },
      {
        "poem_id": "poem_0279",
        "mel_len": 1059,
        "len_bin": "mid",
        "text": "题破山寺后禅院，唐代·常建。清晨入古寺，初日照高林。曲径通幽处，禅房花木深。山光"
      },
      {
        "poem_id": "poem_0075",
        "mel_len": 1305,
        "len_bin": "long",
        "text": "利州南渡，唐代·温庭筠。澹然空水带斜晖，曲岛苍茫接翠微。波上马嘶看棹去，柳边人歇"
      },
      {
        "poem_id": "poem_0137",
        "mel_len": 1314,
        "len_bin": "long",
        "text": "送魏万之京，唐代·李颀。朝闻游子唱离歌，昨夜微霜初渡河。鸿雁不堪愁里听，云山况是"
      },
      {
        "poem_id": "poem_0166",
        "mel_len": 1334,
        "len_bin": "long",
        "text": "登金陵凤凰台，唐代·李白。凤凰台上凤凰游，凤去台空江自流。吴宫花草埋幽径，晋代衣"
      },
      {
        "poem_id": "poem_0037",
        "mel_len": 1352,
        "len_bin": "long",
        "text": "西塞山怀古，唐代·刘禹锡。王濬楼船下益州，金陵王气黯然收。千寻铁锁沉江底，一片降"
      },
      {
        "poem_id": "poem_0110",
        "mel_len": 1383,
        "len_bin": "long",
        "text": "闻官军收河南河北，唐代·杜甫。剑外忽传收蓟北，初闻涕泪满衣裳。却看妻子愁何在，漫"
      },
      {
        "poem_id": "poem_0253",
        "mel_len": 1433,
        "len_bin": "long",
        "text": "无题·重帏深下莫愁堂，唐代·李商隐。重帏深下莫愁堂，卧后清宵细细长。神女生涯原是"
      }
